# ──────────────────────────────────────────────────────────────────────────────
# .dockerignore
# Prevents heavy / sensitive files from being sent to the Docker build context.
# ──────────────────────────────────────────────────────────────────────────────

# Node modules — reinstalled inside container
node_modules
npm-debug.log*

# Next.js build artefacts
.next
out
build

# Version control
.git
.gitignore

# Environment secrets — NEVER bake into image
.env
.env.*
!.env.example

# Editor / OS artefacts
.DS_Store
*.pem
.vscode
.idea
*.tsbuildinfo

# Docker files themselves (no need to copy)
Dockerfile*
docker-compose*.yml
.dockerignore

# CI / misc
coverage
README.md
AGENTS.md
CLAUDE.md
